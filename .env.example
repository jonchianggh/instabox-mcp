# Public HTTPS URL this server is reached at (no trailing slash). The MCP endpoint is $PUBLIC_URL/mcp
PUBLIC_URL=https://instabox-mcp.example.com
# InstaBox API key (dashboard -> API keys)
INSTABOX_API_KEY=
# Password you type on the login page when connecting a client
AUTH_PASSWORD=
# Signs OAuth tokens. openssl rand -hex 32. Changing it signs out every client.
TOKEN_SECRET=
# Optional
# PORT=3000
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=2592000
# MAX_WAIT_SECONDS=45
