# Public HTTPS URL this server is reached at (no trailing slash). The MCP endpoint is $PUBLIC_URL/mcp
PUBLIC_URL=https://instabox-mcp.example.com
# InstaBox API key (dashboard -> API keys)
INSTABOX_API_KEY=
# Password you type on the login page when connecting a client
AUTH_PASSWORD=
# Signs OAuth tokens. openssl rand -hex 32. Changing it signs out every client.
TOKEN_SECRET=
# Optional
# PORT=3000
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=2592000
# MAX_WAIT_SECONDS=45
# Optional static bearer for Claude Code, scripts and curl (>= 32 chars, openssl rand -hex 32).
# Unset = OAuth only.
# MCP_BEARER_TOKEN=
# Client ID Metadata Documents (how Claude signs in). Set false to make clients use dynamic registration.
# CIMD_ENABLED=true
# Only accept metadata documents from these hosts (comma separated, *.example.com allowed). Empty = any public host.
# CIMD_ALLOWED_HOSTS=claude.ai
